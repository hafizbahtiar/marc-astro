---
import logo from "../assets/brand/full_logo.png";
import { Image } from "astro:assets";
---

<section class="hero" id="top">
	<div class="hero__inner">
		<div class="hero__text">
			<p class="hero__eyebrow">Kelab Sukan dan Rekreasi MAIWP</p>
			<h1>Satu tempat untuk semua urusan kelab MARC.</h1>
			<p class="hero__lead">
				Pengumuman, aktiviti, pendaftaran ahli dan notifikasi dalam satu
				portal untuk ahli MARC.
			</p>
			<div class="hero__cta">
				<a href="https://app.marc.hafizbahtiar.com/register" class="button button--primary">
					Daftar di portal web
				</a>
				<a href="#ciri" class="button button--secondary">Lihat ciri utama</a>
			</div>
			<p class="hero__availability">
				Portal web tersedia sekarang. Aplikasi mudah alih sedang disediakan.
			</p>
		</div>
		<div class="hero__art">
			<Image
				src={logo}
				alt="Logo MARC"
				width={320}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 64px 24px 48px;
	}

	.hero__inner {
		max-width: 1080px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 40px;
	}

	.hero__eyebrow {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-primary);
		margin-bottom: 18px;
	}

	h1 {
		font-size: clamp(2.1rem, 4.2vw, 3.2rem);
		color: var(--color-ink);
		max-width: 14ch;
	}

	.hero__lead {
		margin-top: 20px;
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 46ch;
	}

	.hero__cta {
		margin-top: 32px;
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.hero__availability {
		margin-top: 14px;
		font-size: 0.82rem;
		color: var(--color-muted);
	}

	.hero__art {
		display: flex;
		justify-content: center;
	}

	.hero__art :global(img) {
		width: 100%;
		max-width: 320px;
		height: auto;
	}

	@media (max-width: 820px) {
		.hero__inner {
			grid-template-columns: 1fr;
			text-align: center;
		}
		h1 {
			max-width: none;
			margin: 0 auto;
		}
		.hero__lead {
			margin-left: auto;
			margin-right: auto;
		}
		.hero__cta {
			justify-content: center;
		}
		.hero__art {
			order: -1;
		}
		.hero__art :global(img) {
			max-width: 220px;
		}
	}
</style>

<style is:global>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 13px 26px;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.98rem;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	.button--primary {
		background: var(--color-primary);
		color: white;
		border: 1.5px solid var(--color-primary);
	}

	.button--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
	}

	.button--secondary {
		background: transparent;
		color: var(--color-ink);
		border: 1.5px solid var(--color-outline);
	}

	.button--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}
</style>
