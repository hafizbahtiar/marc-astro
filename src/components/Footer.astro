---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner">
		<div>
			<p class="footer__brand">MARC</p>
			<p>&copy; {year} Hafiz Bahtiar</p>
		</div>
		<nav class="footer__links" aria-label="Pautan legal">
			<a href="/terma-dan-syarat">Terma dan Syarat</a>
			<span class="footer__links-sep" aria-hidden="true">&middot;</span>
			<a href="/dasar-privasi">Dasar Privasi</a>
			<span class="footer__links-sep" aria-hidden="true">&middot;</span>
			<a href="/padam-akaun">Padam Akaun</a>
			<span class="footer__links-sep" aria-hidden="true">&middot;</span>
			<a href="/piagam-csae">Standard CSAE</a>
		</nav>
		<p>
			Dibangunkan oleh <a
				href="https://hafizbahtiar.com"
				target="_blank"
				rel="noopener noreferrer">hafizbahtiar.com</a
			>
		</p>
	</div>
</footer>

<style>
	.footer {
		padding: 32px 24px 40px;
		border-top: 1px solid var(--color-outline);
		background: var(--color-third);
	}

	.footer__inner {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.footer__inner p {
		font-size: 0.85rem;
		color: color-mix(in srgb, white 68%, transparent);
	}

	.footer__brand {
		margin-bottom: 5px;
		color: white !important;
		font-family: var(--font-display);
		font-size: 1.15rem !important;
		font-weight: 600;
		letter-spacing: 0.12em;
	}

	.footer__inner a {
		color: var(--color-secondary);
		text-decoration: underline;
	}

	.footer__links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: center;
		row-gap: 6px;
		gap: 10px;
	}

	.footer__links-sep {
		color: var(--color-outline);
	}

	.footer__links a {
		font-size: 0.85rem;
		color: color-mix(in srgb, white 72%, transparent);
		text-decoration: none;
	}

	.footer__links a:hover {
		color: var(--color-primary);
		text-decoration: underline;
	}
</style>
