---
const features = [
	{
		title: "Pengumuman & Perkongsian",
		desc: "Kongsi maklumat, gambar dan pengumuman kelab dalam satu ruang komuniti.",
	},
	{
		title: "Aktiviti Kelab",
		desc: "Daftar aktiviti sukan dan lihat senarai peserta yang turut serta.",
	},
	{
		title: "Keahlian Terurus",
		desc: "Pendaftaran ahli baharu disemak pihak pengurusan sebelum akses diberikan.",
	},
	{
		title: "Notifikasi",
		desc: "Terima makluman berkaitan pengumuman, aktiviti dan sijil kelab.",
	},
	{
		title: "Bayaran Aktiviti",
		desc: "Bayar yuran pendaftaran dan aktiviti, kemudian muat turun resit apabila diperlukan.",
	},
	{
		title: "Sijil Digital",
		desc: "Muat turun sijil penyertaan aktiviti selepas kehadiran direkodkan.",
	},
];
---

<section class="features" id="ciri">
	<div class="features__inner">
		<div class="section-intro">
			<p class="section-kicker">Dalam satu tempat</p>
			<h2>Ciri utama</h2>
			<p>Keperluan asas ahli dan pengurusan kelab dalam satu portal.</p>
		</div>
		<div class="features__grid">
			{
				features.map((f) => (
					<div class="feature-card">
						<h3>{f.title}</h3>
						<p>{f.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.features {
		padding: 72px 24px;
	}

	.features__inner {
		max-width: 1080px;
		margin: 0 auto;
	}

	h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin-bottom: 12px;
	}

	.section-intro {
		max-width: 560px;
		margin-bottom: 40px;
	}

	.section-kicker {
		margin-bottom: 8px;
		color: var(--color-secondary-dark);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.section-intro > p:last-child {
		color: var(--color-muted);
		line-height: 1.6;
	}

	.features__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.feature-card {
		padding: 24px 0 28px;
		border-top: 1px solid var(--color-outline);
	}

	.feature-card h3 {
		font-size: 1.1rem;
		margin-bottom: 8px;
	}

	.feature-card p {
		font-size: 0.94rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.features__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.features__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
