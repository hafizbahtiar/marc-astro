---
const features = [
	{
		icon: "📣",
		title: "Pengumuman & Post",
		desc: "Kongsi maklumat, gambar dan pengumuman kelab dalam satu feed komuniti - like dan comment terus.",
	},
	{
		icon: "🏸",
		title: "Aktiviti Kelab",
		desc: "Daftar aktiviti sukan (badminton, futsal, bola tampar, larian, ping pong) dan tengok siapa lagi turut serta.",
	},
	{
		icon: "✅",
		title: "Keahlian Terurus",
		desc: "Pendaftaran ahli baharu disemak pihak pengurusan sebelum akses penuh - jelas siapa ahli sebenar kelab.",
	},
	{
		icon: "🔔",
		title: "Notifikasi Segera",
		desc: "Dapat tahu terus bila ada pengumuman, aktiviti baharu, atau sijil sudah sedia - tak perlu buka app selalu.",
	},
	{
		icon: "🧾",
		title: "Bayaran Dalam App",
		desc: "Yuran pendaftaran dan aktiviti boleh dibayar terus dalam app, dengan resit yang boleh dimuat turun bila-bila.",
	},
	{
		icon: "🏅",
		title: "Sijil Digital",
		desc: "Sijil penyertaan aktiviti dijana automatik dan boleh dimuat turun terus dari app selepas hadir.",
	},
];
---

<section class="features" id="ciri">
	<div class="features__inner">
		<div class="section-intro">
			<p class="section-kicker">Dalam satu tempat</p>
			<h2>Ciri-ciri utama</h2>
			<p>Perkara penting untuk urusan ahli dan pengurusan kelab, tanpa aliran yang berselerak.</p>
		</div>
		<div class="features__grid">
			{
				features.map((f) => (
					<div class="feature-card">
						<div class="feature-card__icon" aria-hidden="true">
							{f.icon}
						</div>
						<h3>{f.title}</h3>
						<p>{f.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.features {
		padding: 72px 24px;
	}

	.features__inner {
		max-width: 1080px;
		margin: 0 auto;
	}

	h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin-bottom: 12px;
	}

	.section-intro {
		max-width: 560px;
		margin-bottom: 40px;
	}

	.section-kicker {
		margin-bottom: 8px;
		color: var(--color-secondary-dark);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.section-intro > p:last-child {
		color: var(--color-muted);
		line-height: 1.6;
	}

	.features__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.feature-card {
		background: var(--color-surface);
		border: 1px solid var(--color-outline);
		border-radius: 14px;
		padding: 28px 24px;
		box-shadow: 0 10px 30px color-mix(in srgb, var(--color-third) 5%, transparent);
	}

	.feature-card__icon {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.5rem;
		background: color-mix(in srgb, var(--color-secondary) 18%, transparent);
		border-radius: 12px;
		margin-bottom: 16px;
	}

	.feature-card h3 {
		font-size: 1.1rem;
		margin-bottom: 8px;
	}

	.feature-card p {
		font-size: 0.94rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.features__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.features__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
