---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Sahkan Sijil — MARC"
	description="Semakan keesahan sijil penyertaan aktiviti MARC."
>
	<Header />
	<main class="status">
		<div class="status__card">
			<div id="state-loading" class="status__state">
				<div class="status__spinner" aria-hidden="true"></div>
				<h1>Menyemak sijil&hellip;</h1>
				<p>Sila tunggu sebentar.</p>
			</div>
			<div id="state-valid" class="status__state" hidden>
				<div class="status__icon status__icon--ok" aria-hidden="true">
					&check;
				</div>
				<h1>Sijil sah</h1>
				<dl class="status__details">
					<div>
						<dt>Nama Penerima</dt>
						<dd id="detail-name"></dd>
					</div>
					<div>
						<dt>Aktiviti</dt>
						<dd id="detail-activity"></dd>
					</div>
					<div>
						<dt>Tarikh Aktiviti</dt>
						<dd id="detail-date"></dd>
					</div>
					<div>
						<dt>Nombor Siri</dt>
						<dd id="detail-serial"></dd>
					</div>
				</dl>
			</div>
			<div id="state-revoked" class="status__state" hidden>
				<div class="status__icon status__icon--err" aria-hidden="true">
					!
				</div>
				<h1>Sijil ditarik balik</h1>
				<p>
					Sijil ini telah ditarik balik oleh pihak pengurusan MARC dan
					tidak lagi sah.
				</p>
			</div>
			<div id="state-notfound" class="status__state" hidden>
				<div class="status__icon status__icon--err" aria-hidden="true">
					!
				</div>
				<h1>Sijil tidak dijumpai</h1>
				<p>
					Pautan ini tidak sah atau sijil tidak wujud dalam rekod
					MARC.
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<script define:vars={{ apiBaseUrl: import.meta.env.PUBLIC_API_BASE_URL ?? "" }}>
	const loading = document.getElementById("state-loading");
	const valid = document.getElementById("state-valid");
	const revoked = document.getElementById("state-revoked");
	const notfound = document.getElementById("state-notfound");

	function show(target) {
		for (const node of [loading, valid, revoked, notfound]) {
			node.hidden = node !== target;
		}
	}

	const token = new URLSearchParams(window.location.search).get("token");

	if (!token || !apiBaseUrl) {
		show(notfound);
	} else {
		fetch(`${apiBaseUrl}/verify/certificates/${encodeURIComponent(token)}`)
			.then((res) => {
				if (res.status === 404) {
					show(notfound);
					return;
				}
				return res.json().then((body) => {
					if (body.status === "ditarik_balik") {
						show(revoked);
						return;
					}
					document.getElementById("detail-name").textContent =
						body.recipient_name;
					document.getElementById("detail-activity").textContent =
						body.activity_title;
					document.getElementById("detail-date").textContent =
						body.activity_date;
					document.getElementById("detail-serial").textContent =
						body.serial;
					show(valid);
				});
			})
			.catch(() => show(notfound));
	}
</script>

<style>
	.status {
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 64px 24px;
	}

	.status__card {
		max-width: 440px;
		width: 100%;
		text-align: center;
	}

	.status__state h1 {
		font-size: 1.5rem;
		margin-bottom: 10px;
	}

	.status__state p {
		color: var(--color-muted);
		line-height: 1.6;
	}

	.status__spinner {
		width: 36px;
		height: 36px;
		margin: 0 auto 20px;
		border-radius: 50%;
		border: 3px solid var(--color-outline);
		border-top-color: var(--color-primary);
		animation: spin 0.8s linear infinite;
	}

	.status__icon {
		width: 48px;
		height: 48px;
		margin: 0 auto 18px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
		font-weight: 700;
	}

	.status__icon--ok {
		background: color-mix(in srgb, var(--color-primary) 16%, transparent);
		color: var(--color-primary);
	}

	.status__icon--err {
		background: var(--color-warning-bg);
		color: var(--color-warning);
	}

	.status__details {
		margin-top: 24px;
		text-align: left;
		background: var(--color-surface);
		border-radius: 12px;
		padding: 20px 24px;
	}

	.status__details div + div {
		margin-top: 12px;
	}

	.status__details dt {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-muted);
	}

	.status__details dd {
		margin: 2px 0 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-ink);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
